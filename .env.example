ATLAS_WEB_BIND=127.0.0.1
ATLAS_WEB_PORT=3000
# Limits for the future host; tune after measuring an actual run.
ATLAS_WEB_MEMORY=2g
ATLAS_DATA_MEMORY=1g
ATLAS_COLLECTOR_MEMORY=3g
ATLAS_AI_MEMORY=4g
ATLAS_WEB_CPUS=2
ATLAS_DATA_CPUS=1
ATLAS_COLLECTOR_CPUS=2
# Optional existing Ollama service. No cloud fallback.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=
# Native runs only; Docker sets these internally.
ATLAS_DATA_URL=http://127.0.0.1:8787
ATLAS_STATE=.atlas-state
# Direct remote readers require HTTPS and an explicit allowed origin.
ATLAS_CORS_ORIGINS=
ATLAS_READ_TOKEN=
